// ============================================================
// Firebase Storage Security Rules
// ============================================================
//
// These rules control who can upload and download files from
// Firebase Storage (vehicle and service images).
// Deploy them using: firebase deploy --only storage
// ============================================================

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ===== Vehicle images =====
    // Anyone can view (public website needs to display images)
    // Only admins can upload
    match /vehicles/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ===== Service images =====
    // Anyone can view. Only admins can upload.
    match /services/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ===== Default: deny all other access =====
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
